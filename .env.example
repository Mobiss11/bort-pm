# Борт — переменные окружения
# Скопируйте в .env при необходимости: cp .env.example .env

# Путь к файлу SQLite-базы
BORT_DB=$HOME/bort/data/bort.db

# Локальная часовая зона (для вычисления «сегодня» и подсветки дедлайнов)
BORT_TZ=Europe/Moscow

# Хост и порт веб-сервера. НЕ менять на 0.0.0.0 — сервер без аутентификации
BORT_HOST=127.0.0.1
BORT_PORT=8100

# AI-вкладка: ключи считываются только сервером, не сохраняются в SQLite.
# DEEPSEEK_API_KEY=...
# Для GPT-подписки: используем уже установленный и авторизованный Codex CLI.
# Убедитесь, что он вошёл в ту же учётную запись ChatGPT, что и OpenCode.

# Вкладка «Задачи» (источник Beads): корни с проектами (до двух каталогов).
# По умолчанию: ~/Documents. Несколько корней разделяйте двоеточием (macOS).
# BORT_BEADS_ROOTS=$HOME/Documents:$HOME/Work
# BORT_BEADS_BIN=/opt/homebrew/bin/bd  # если bd не виден процессу PM2
# На mini без bd: снимок с MacBook, обновляемый отдельным LaunchAgent на MacBook.
# BORT_BEADS_SNAPSHOT=$HOME/bort/data/beads-snapshot.json
